# All VITE_* variables are bundled into the public frontend. NEVER put secrets here.
# Public URL of the deployed site (used for canonical and social metadata).
VITE_SITE_URL=https://example.pages.dev
# Optional: load the catalogue from another public URL. Defaults to /data/releases.json
VITE_CATALOGUE_URL=
# Optional: public contact address shown on creator and takedown pages.
VITE_CONTACT_EMAIL=
