# All VITE_* variables are bundled into the public frontend. NEVER put secrets here.
# Public URL of the deployed site (used for canonical and social metadata).
VITE_SITE_URL=https://naijafreedownload.pages.dev
# Optional: load the catalogue from another public URL. Defaults to /data/releases.json
VITE_CATALOGUE_URL=
# Optional: public contact address shown on creator and takedown pages.
VITE_CONTACT_EMAIL=

# --- Google AdSense (leave all blank until Google has approved the site) ---
# Ads render only when ALL THREE are set and ENABLED is exactly "true". Nothing is invented or defaulted.
VITE_ADS_ENABLED=
# Your publisher ID from AdSense, format ca-pub-0000000000000000
VITE_ADSENSE_CLIENT=
# Ad unit (slot) ID for content-page ads, digits only
VITE_ADSENSE_SLOT_DETAIL=
